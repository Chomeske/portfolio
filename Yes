<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Olesia Shaikhutdinova — AI Narrative Designer & Character Architect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0e0e11;
      --bg-elevated: #16161b;
      --bg-card: #1b1b22;
      --border: #2a2a35;
      --text: #eae8e3;
      --text-muted: #9b99a3;
      --accent: #e09f5a;
      --accent-soft: rgba(224, 159, 90, 0.14);
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --font-mono: 'Courier Prime', 'Courier New', monospace;
      --radius: 10px;
      --max-width: 1160px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(14, 14, 17, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 26px;
    }

    nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    nav a:hover { color: var(--accent); }

    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 24px 96px;
    }

    section { padding-top: 76px; }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--accent);
      margin-bottom: 10px;
      display: block;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-serif);
      font-weight: 600;
      line-height: 1.15;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 2.75rem);
      margin-bottom: 14px;
    }

    .section-intro {
      color: var(--text-muted);
      max-width: 720px;
      margin-bottom: 28px;
      font-size: 0.96rem;
    }

    /* Hero / About */
    .hero {
      padding-top: 58px;
      padding-bottom: 48px;
      border-bottom: 1px solid var(--border);
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 44px;
      align-items: start;
    }

    .hero h1 {
      font-size: clamp(2.6rem, 5.2vw, 4.1rem);
      margin-bottom: 14px;
    }

    .hero h1 span {
      font-style: italic;
      color: var(--accent);
    }

    .roles {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 22px;
    }

    .hero-bio {
      font-size: 1.03rem;
      color: #d6d3cc;
      margin-bottom: 18px;
      max-width: 620px;
    }

    .craft-callout {
      background: rgba(224, 159, 90, 0.06);
      border-left: 2px solid var(--accent);
      padding: 14px 18px;
      margin: 22px 0 26px;
      font-size: 0.92rem;
      color: #cfc8bc;
      border-radius: 0 6px 6px 0;
    }

    .craft-callout strong {
      color: var(--text);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: #12100e;
    }

    .btn-primary:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
    }

    .btn-ghost {
      background: transparent;
      border-color: var(--border);
      color: var(--text);
    }

    .btn-ghost:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .dossier-card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      font-family: var(--font-mono);
      font-size: 0.82rem;
    }

    .dossier-header {
      border-bottom: 1px dashed var(--border);
      padding-bottom: 12px;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
    }

    .dossier-row { margin-bottom: 14px; }

    .dossier-key {
      color: var(--accent);
      display: block;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 2px;
    }

    /* Competencies & Workflow strip */
    .competencies-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-top: 32px;
    }

    .comp-box {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
    }

    .comp-box h3 {
      font-size: 1.25rem;
      margin-bottom: 8px;
      color: var(--accent);
    }

    .comp-box p {
      font-size: 0.86rem;
      color: var(--text-muted);
    }

    /* Featured */
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
    }

    .featured-card {
      background: linear-gradient(160deg, var(--bg-card) 0%, #141419 100%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .featured-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), transparent);
      opacity: 0.75;
    }

    .featured-card:hover {
      transform: translateY(-4px);
      border-color: rgba(224, 159, 90, 0.55);
    }

    .card-meta {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent);
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .featured-card h3 {
      font-size: 1.65rem;
      margin-bottom: 8px;
    }

    .tagline {
      font-style: italic;
      color: #d6c5ae;
      font-size: 0.9rem;
      margin-bottom: 12px;
    }

    .card-desc {
      color: var(--text-muted);
      font-size: 0.91rem;
      margin-bottom: 18px;
    }

    /* Tags */
    .tags-list {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 16px;
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      padding: 4px 9px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }

    .tag:hover, .tag.active {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Thematic Collections */
    .collections-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
      margin-bottom: 20px;
    }

    .collection-tile {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      color: inherit;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .collection-tile:hover, .collection-tile.active {
      border-color: var(--accent);
      background: rgba(224, 159, 90, 0.07);
    }

    .collection-count {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--accent);
      margin-bottom: 8px;
      display: block;
    }

    .collection-tile h3 {
      font-size: 1.35rem;
      margin-bottom: 8px;
    }

    .collection-tile p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* Filter panel & Archive */
    .filter-panel {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px 24px;
      margin-bottom: 28px;
    }

    .filter-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .filter-title {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text);
    }

    .reset-btn {
      background: none;
      border: none;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      cursor: pointer;
      text-decoration: underline;
    }

    .archive-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(315px, 1fr));
      gap: 20px;
    }

    .archive-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: border-color 0.2s;
    }

    .archive-card:hover { border-color: #464659; }

    .archive-card h4 {
      font-size: 1.4rem;
      margin-bottom: 6px;
    }

    .read-link {
      background: none;
      border: none;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      cursor: pointer;
      padding: 0;
      text-align: left;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .read-link:hover { text-decoration: underline; }

    /* Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(8, 8, 11, 0.86);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
    }

    .modal-overlay.open { display: flex; }

    .modal {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      max-width: 820px;
      width: 100%;
      max-height: 88vh;
      overflow-y: auto;
      padding: 36px;
      position: relative;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    }

    .modal-close {
      position: absolute;
      top: 18px;
      right: 20px;
      background: none;
      border: 1px solid var(--border);
      color: var(--text-muted);
      width: 34px;
      height: 34px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .modal-close:hover {
      color: var(--text);
      border-color: var(--accent);
    }

    .modal-block {
      background: #101014;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 22px;
      margin-top: 18px;
      font-size: 0.92rem;
      color: #dedad0;
    }

    .modal-block-title {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 10px;
      display: block;
    }

    .mono-excerpt {
      font-family: var(--font-mono);
      font-size: 0.84rem;
      line-height: 1.58;
    }

    .modal-block p + p { margin-top: 10px; }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 48px;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      color: var(--text-muted);
    }

    /* Footer */
    footer {
      border-top: 1px solid var(--border);
      padding: 38px 24px;
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    @media (max-width: 840px) {
      .hero { grid-template-columns: 1fr; }
      nav ul { gap: 14px; font-size: 0.8rem; }
      .modal { padding: 24px 18px; }
    }
  </style>
</head>
