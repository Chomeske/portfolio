        summary: "General Alaric 'Fierce Pride' Valen, raised from birth as the son her general father wanted, forced into a post-war political marriage with the princess.",
        tags: ["#Psychological_Realism", "#Character_Bible", "#Historical_&_Gothic"],
        blocks: [
          {
            title: "Internal Conflict & Voice",
            mono: false,
            html: `
              <p>Commands absolute authority in military logistics and tactics, yet falters into dry humor, awkwardness, or retreat into her soldier persona in private intimacy—referring to herself strictly in masculine or soldierly terms unless gently guided toward self-acceptance.</p>
            `
          }
        ]
      },
      {
        id: "sarraya-calviolla",
        featured: false,
        collection: "worldbuilding",
        title: "Sarraya Calviolla (King George V)",
        source: "Forum RP Archive • Military Sci-Fi",
        format: "Mecha / Battleship Core Pilot",
        tagline: "An iron-muscled battleship pilot hidden under modest skirts, fighting to protect 'God in every human being.'",
        summary: "A devout, quietly stubborn 17-year-old Alpha-Core pilot inspired by the tragedy of losing her Australian penpal to Deep Sea Monsters.",
        tags: ["#Sci_Fi_&_Cyberpunk", "#Character_Bible", "#Psychological_Realism"],
        blocks: [
          {
            title: "Character Nuance",
            mono: false,
            html: `
              <p>Outwardly resembles a gentle, dandelion-haired "nun" in long modest skirts—concealing a heavy-weight athletic frame. Completely shameless rather than shy, respectful yet quietly defiant toward rank, and haunted by an unresolved moral incident from her early prayer circle.</p>
            `
          }
        ]
      }
    ];

    // ==============================
    // STATE & RENDERING
    // ==============================
    let activeCollection = null;
    let activeTag = null;

    const featuredEl = document.getElementById("featured-container");
    const collectionsEl = document.getElementById("collections-container");
    const tagsCloudEl = document.getElementById("tags-cloud");
    const archiveEl = document.getElementById("archive-container");
    const filterLabelEl = document.getElementById("active-filter-label");
    const resetBtn = document.getElementById("reset-filters");

    const allTags = [...new Set(projects.flatMap(p => p.tags))].sort();

    function createTagButtons(tags, clickable = true) {
      return tags.map(tag => {
        const isActive = activeTag === tag ? "active" : "";
        return clickable
          ? `<button class="tag ${isActive}" data-tag="${tag}">${tag}</button>`
          : `<span class="tag">${tag}</span>`;
      }).join("");
    }

    function renderFeatured() {
      const featured = projects.filter(p => p.featured);
      featuredEl.innerHTML = featured.map(p => `
        <article class="featured-card">
          <div>
            <div class="card-meta">
              <span>${p.source}</span>
              <span>★ FEATURED</span>
            </div>
            <h3>${p.title}</h3>
            <p class="tagline">"${p.tagline}"</p>
            <p class="card-desc">${p.summary}</p>
          </div>
          <div>
            <div class="tags-list">${createTagButtons(p.tags)}</div>
            <button class="read-link" data-open="${p.id}">Read case &amp; excerpts →</button>
          </div>
        </article>
      `).join("");
    }

    function renderCollections() {
      collectionsEl.innerHTML = collections.map(col => {
        const count = projects.filter(p => p.collection === col.id).length;
        const isActive = activeCollection === col.id ? "active" : "";
        return `
          <button class="collection-tile ${isActive}" data-collection="${col.id}">
            <div>
              <span class="collection-count">COLLECTION • ${count} WORKS</span>
              <h3>${col.title}</h3>
            </div>
            <p>${col.desc}</p>
          </button>
        `;
      }).join("");
    }

    function renderTagsCloud() {
      tagsCloudEl.innerHTML = allTags.map(tag => {
        const isActive = activeTag === tag ? "active" : "";
        return `<button class="tag ${isActive}" data-tag="${tag}">${tag}</button>`;
      }).join("");
    }

    function renderArchive() {
      let filtered = projects;
      if (activeCollection) {
        filtered = filtered.filter(p => p.collection === activeCollection);
      }
      if (activeTag) {
        filtered = filtered.filter(p => p.tags.includes(activeTag));
      }

      const parts = [];
      if (activeCollection) {
        const colObj = collections.find(c => c.id === activeCollection);
        parts.push(`Collection "${colObj.title}"`);
      }
      if (activeTag) {
        parts.push(`Tag ${activeTag}`);
      }

      filterLabelEl.textContent = parts.length
        ? `Filter: ${parts.join(" + ")} (${filtered.length} shown)`
        : `Filter: All Works (${filtered.length})`;

      resetBtn.style.display = (activeCollection || activeTag) ? "inline-block" : "none";

      if (filtered.length === 0) {
        archiveEl.innerHTML = `
          <div class="empty-state">
            No works match this combination of collection and tag. Try clearing one filter.
          </div>
        `;
        return;
      }

      archiveEl.innerHTML = filtered.map(p => `
        <article class="archive-card">
          <div>
            <div class="card-meta">
              <span>${p.format}</span>
            </div>
            <h4>${p.title}</h4>
            <p class="tagline" style="font-size:0.84rem;margin-bottom:8px;">"${p.tagline}"</p>
            <p class="card-desc">${p.summary}</p>
          </div>
          <div>
            <div class="tags-list">${createTagButtons(p.tags)}</div>
            <button class="read-link" data-open="${p.id}">Open profile &amp; notes →</button>
          </div>
        </article>
      `).join("");
    }

    function updateUI() {
      renderFeatured();
      renderCollections();
      renderTagsCloud();
      renderArchive();
    }

    // Event Delegation
    document.addEventListener("click", (e) => {
      const colBtn = e.target.closest("[data-collection]");
      if (colBtn) {
        const id = colBtn.dataset.collection;
        activeCollection = activeCollection === id ? null : id;
        updateUI();
        document.getElementById("archive").scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }

      const tagBtn = e.target.closest("[data-tag]");
      if (tagBtn) {
        const tag = tagBtn.dataset.tag;
        activeTag = activeTag === tag ? null : tag;
        updateUI();
        document.getElementById("archive").scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }

      const openBtn = e.target.closest("[data-open]");
      if (openBtn) {
        openModal(openBtn.dataset.open);
        return;
      }
    });

    resetBtn.addEventListener("click", () => {
      activeCollection = null;
      activeTag = null;
      updateUI();
    });

    // Modal
    const modalOverlay = document.getElementById("project-modal");
    const modalClose = document.getElementById("modal-close");

    function openModal(id) {
      const p = projects.find(item => item.id === id);
      if (!p) return;

      document.getElementById("modal-meta").textContent = `${p.source} • ${p.format}`;
      document.getElementById("modal-title").textContent = p.title;
      document.getElementById("modal-tags").innerHTML = createTagButtons(p.tags, false);
      document.getElementById("modal-tagline").textContent = `"${p.tagline}"`;
      document.getElementById("modal-summary").textContent = p.summary;

      document.getElementById("modal-body").innerHTML = p.blocks.map(b => `
        <div class="modal-block ${b.mono ? "mono-excerpt" : ""}">
          <span class="modal-block-title">${b.title}</span>
          ${b.html}
        </div>
      `).join("");

      modalOverlay.classList.add("open");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modalOverlay.classList.remove("open");
      document.body.style.overflow = "";
    }

    modalClose.addEventListener("click", closeModal);
    modalOverlay.addEventListener("click", (e) => {
      if (e.target === modalOverlay) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });

    updateUI();
  </script>
</body>
</html>
