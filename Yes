<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Алекс Вейн — Сценарист, Автор персонажей, Нарративный дизайнер</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0e0e11;
      --bg-elevated: #16161b;
      --bg-card: #1b1b22;
      --border: #2a2a35;
      --text: #eae8e3;
      --text-muted: #9b99a3;
      --accent: #e09f5a;
      --accent-soft: rgba(224, 159, 90, 0.14);
      --danger: #d46a6a;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --font-mono: 'Courier Prime', 'Courier New', monospace;
      --radius: 10px;
      --max-width: 1140px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    /* Навигация */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(14, 14, 17, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 28px;
    }

    nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    nav a:hover {
      color: var(--accent);
    }

    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 24px 96px;
    }

    section {
      padding-top: 72px;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--accent);
      margin-bottom: 10px;
      display: block;
    }

    h1, h2, h3 {
      font-family: var(--font-serif);
      font-weight: 600;
      line-height: 1.15;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 2.8rem);
      margin-bottom: 24px;
    }

    /* Главная (О себе) */
    .hero {
      padding-top: 64px;
      padding-bottom: 48px;
      border-bottom: 1px solid var(--border);
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 48px;
      align-items: start;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 6vw, 4.4rem);
      margin-bottom: 16px;
    }

    .hero h1 span {
      font-style: italic;
      color: var(--accent);
    }

    .roles {
      font-family: var(--font-mono);
      font-size: 0.92rem;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .hero-bio {
      font-size: 1.08rem;
      color: #d3d0c9;
      margin-bottom: 28px;
      max-width: 600px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: #12100e;
    }

    .btn-primary:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
    }

    .btn-ghost {
      background: transparent;
      border-color: var(--border);
      color: var(--text);
    }

    .btn-ghost:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .dossier-card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }

    .dossier-header {
      border-bottom: 1px dashed var(--border);
      padding-bottom: 12px;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
    }

    .dossier-row {
      margin-bottom: 12px;
    }

    .dossier-key {
      color: var(--accent);
      display: block;
      font-size: 0.75rem;
      text-transform: uppercase;
    }

    /* Избранная подборка */
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 24px;
    }

    .featured-card {
      background: linear-gradient(160deg, var(--bg-card) 0%, #141419 100%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .featured-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), transparent);
      opacity: 0.7;
    }

    .featured-card:hover {
      transform: translateY(-4px);
      border-color: rgba(224, 159, 90, 0.5);
    }

    .card-meta {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--accent);
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
    }

    .featured-card h3 {
      font-size: 1.7rem;
      margin-bottom: 12px;
    }

    .card-desc {
      color: var(--text-muted);
      font-size: 0.94rem;
      margin-bottom: 20px;
    }

    /* Теги */
    .tags-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }

    .tag:hover, .tag.active {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Тематические сборники */
    .collections-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-bottom: 40px;
    }

    .collection-tile {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      color: inherit;
    }

    .collection-tile:hover, .collection-tile.active {
      border-color: var(--accent);
      background: rgba(224, 159, 90, 0.06);
    }

    .collection-count {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent);
      margin-bottom: 8px;
      display: block;
    }

    .collection-tile h3 {
      font-size: 1.35rem;
      margin-bottom: 8px;
    }

    .collection-tile p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* Фильтр-бар по тегам и каталог всех работ */
    .filter-panel {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px 24px;
      margin-bottom: 28px;
    }

    .filter-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .filter-title {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text);
    }

    .reset-btn {
      background: none;
      border: none;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      cursor: pointer;
      text-decoration: underline;
    }

    .archive-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }

    .archive-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: border-color 0.2s;
    }

    .archive-card:hover {
      border-color: #444456;
    }

    .archive-card h4 {
      font-family: var(--font-serif);
      font-size: 1.4rem;
      margin-bottom: 8px;
    }

    .read-link {
      background: none;
      border: none;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      cursor: pointer;
      padding: 0;
      text-align: left;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .read-link:hover {
      text-decoration: underline;
    }

    /* Модальное окно (Сценарий / Персонаж / Нарратив) */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(8, 8, 11, 0.85);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      max-width: 760px;
      width: 100%;
      max-height: 88vh;
      overflow-y: auto;
      padding: 36px;
      position: relative;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    }

    .modal-close {
      position: absolute;
      top: 20px;
      right: 22px;
      background: none;
      border: 1px solid var(--border);
      color: var(--text-muted);
      width: 34px;
      height: 34px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .modal-close:hover {
      color: var(--text);
      border-color: var(--accent);
    }

    .script-excerpt {
      background: #101014;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 24px;
      margin-top: 20px;
      font-family: var(--font-mono);
      font-size: 0.88rem;
      line-height: 1.55;
      color: #dedad0;
    }

    .script-slug {
      text-transform: uppercase;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .script-char {
      text-align: center;
      text-transform: uppercase;
      margin-top: 14px;
      letter-spacing: 0.08em;
      color: #fff;
    }

    .script-paren {
      text-align: center;
      color: var(--text-muted);
      font-style: italic;
    }

    .script-dialogue {
      max-width: 75%;
      margin: 2px auto 12px;
    }

    /* Подвал */
    footer {
      border-top: 1px solid var(--border);
      padding: 40px 24px;
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 48px;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      color: var(--text-muted);
    }

    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
      }
      nav ul {
        gap: 14px;
        font-size: 0.82rem;
      }
      .modal {
        padding: 24px 18px;
      }
      .script-dialogue {
        max-width: 100%;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="nav-inner">
      <a href="#about" class="logo">
        <span class="logo-dot"></span>
        АЛЕКС ВЕЙН // НАРРАТИВ
      </a>
      <nav>
        <ul>
          <li><a href="#about">Обо мне</a></li>
          <li><a href="#featured">Избранное</a></li>
          <li><a href="#collections">Сборники</a></li>
          <li><a href="#archive">Теги и архив</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <!-- 1. ГЛАВНАЯ СТРАНИЦА / ОПИСАНИЕ МЕНЯ -->
    <section id="about" class="hero">
      <div>
        <span class="section-label">Драматургия × Интерактив × Характеры</span>
        <h1>Истории, в которых хочется <span>жить и ошибаться</span></h1>
        <p class="roles">Сценарист • Автор персонажей • Нарративный дизайнер</p>
        <p class="hero-bio">
          Привет! Я проектирую миры, пишу живые диалоги и собираю персонажей, у которых есть собственные тайны, противоречия и голос. Работаю на стыке кинодраматургии и геймдева: от линейных сценариев и библий серий до нелинейных веток в Ink/Articy и системного нарратива, где механика говорит громче реплик.
        </p>
        <div class="hero-actions">
          <a href="#featured" class="btn btn-primary">Смотреть избранное</a>
          <a href="mailto:narrative@example.com" class="btn btn-ghost">Связаться по проекту</a>
        </div>
      </div>

      <aside class="dossier-card">
        <div class="dossier-header">
          <span>ДОСЬЕ АВТОРА</span>
          <span>СТАТУС: ОТКРЫТ</span>
        </div>
        <div class="dossier-row">
          <span class="dossier-key">Специализация</span>
          Киносценарии, нарративные системы, дизайн персонажей (от архетипа до барк-листов).
        </div>
        <div class="dossier-row">
          <span class="dossier-key">Инструменты</span>
          Final Draft, Kit Scenarist, Articy:draft, Ink, Twine, Miro, Notion.
        </div>
        <div class="dossier-row">
          <span class="dossier-key">Сильные жанры</span>
          Неонуар, мрачное фэнтези, sci-fi драма, психологический триллер.
        </div>
        <div class="dossier-row" style="margin-bottom:0;">
          <span class="dossier-key">Контакты</span>
          TG: @narrative_wayne • narrative@example.com
        </div>
      </aside>
    </section>

    <!-- 2. ИЗБРАННАЯ ПОДБОРКА -->
    <section id="featured">
      <span class="section-label">Выбор редакции (и мой)</span>
      <h2>Избранная подборка</h2>
      <div class="featured-grid" id="featured-container">
        <!-- Рендерится из JS -->
      </div>
    </section>

    <!-- 3. ТЕМАТИЧЕСКИЕ СБОРНИКИ -->
    <section id="collections">
      <span class="section-label">Кураторские серии</span>
      <h2>Тематические сборники</h2>
      <div class="collections-grid" id="collections-container">
        <!-- Рендерится из JS -->
      </div>
    </section>

    <!-- 4. ТЕГИ И ПОЛНЫЙ КАТАЛОГ РАБОТ -->
    <section id="archive">
      <span class="section-label">Навигация по навыкам и форматам</span>
      <h2>Все работы и теги</h2>

      <div class="filter-panel">
        <div class="filter-header">
          <span class="filter-title" id="active-filter-label">Фильтр: Все работы</span>
          <button class="reset-btn" id="reset-filters" style="display:none;">Сбросить фильтры ✕</button>
        </div>
        <div class="tags-list" id="tags-cloud">
          <!-- Теги рендерятся из JS -->
        </div>
      </div>

      <div class="archive-grid" id="archive-container">
        <!-- Карточки рендерятся из JS -->
      </div>
    </section>
  </main>

  <footer>
    <span>© 2025 Алекс Вейн — Сценарист, автор персонажей, нарративный дизайнер</span>
    <span>Собрано с любовью к хорошей структуре и плохим решениям героев.</span>
  </footer>

  <!-- МОДАЛЬНОЕ ОКНО С ПРИМЕРОМ ТЕКСТА -->
  <div class="modal-overlay" id="project-modal">
    <div class="modal">
      <button class="modal-close" id="modal-close" aria-label="Закрыть">✕</button>
      <span class="section-label" id="modal-role"></span>
      <h2 id="modal-title" style="margin-bottom:10px;"></h2>
      <div class="tags-list" id="modal-tags"></div>
      <p id="modal-summary" style="color: var(--text-muted);"></p>
      <div class="script-excerpt" id="modal-excerpt"></div>
    </div>
  </div>

  <script>
    // ==============================
    // ДАННЫЕ ПОРТФОЛИО (легко редактировать)
    // ==============================
    const collections = [
      {
        id: "noir-sci-fi",
        title: "Кибернуар и холодный космос",
        desc: "Истории о памяти, корпоративном цинизме и людях на краю орбиты."
      },
      {
        id: "dark-fantasy",
        title: "Мрачный фольклор",
        desc: "Сказки без морали, древние сделки и боги, которые устали."
      },
      {
        id: "character-bibles",
        title: "Библии персонажей",
        desc: "Глубокие профайлы героев: травмы, арки, речевые паттерны и барки."
      },
      {
        id: "interactive-systems",
        title: "Ветвящийся нарратив",
        desc: "Диалоговые деревья, реактивность мира и сценарные прототипы на Ink."
      }
    ];

    const projects = [
      {
        id: 1,
        featured: true,
        collection: "noir-sci-fi",
        title: "Стеклянный дождь на Титане",
        role: "Нарративный дизайнер / Сценарист",
        format: "Sci-Fi RPG (пилот + квест-система)",
        summary: "Детективный квест на орбитальной станции, где каждое обвинение меняет состав кислородных квот в секторе. 45+ узлов реактивности, 3 нелинейные концовки.",
        tags: ["#ветвящийся_нарратив", "#кибернуар", "#диалоги", "#Articy"],
        excerpt: `
          <div class="script-slug">[УЗЕЛ: ДОПРОС_МЕХАНИКА // СОСТОЯНИЕ: ДОВЕРИЕ >= 2]</div>
          <p><strong>ВЫБОР ИГРОКА:</strong></p>
          <p>1. [УЛИКА: Сгоревший чип] «Твоя подпись на прошивке шлюза, Карл.»</p>
          <p>2. [ЭМПАТИЯ] «В этом отсеке пахнет озоном уже неделю. Ты пытался всех спасти?»</p>
          <p>3. [МОЛЧАНИЕ] (Положить карту доступа на стол и ждать)</p>
          <br>
          <p><em>-> Если выбран вариант 3:</em> Карл не выдерживает паузы дольше шести секунд (скрытый таймер реакции). Его реплика раскрывает код от нижнего уровня без проверки навыка.</p>
        `
      },
      {
        id: 2,
        featured: true,
        collection: "character-bibles",
        title: "Досье: Марта «Игла» Кроу",
        role: "Автор персонажей",
        format: "Character Bible / Арка на 3 акта",
        summary: "Циничный картограф мёртвых городов, которая продаёт чужие маршруты, но втайне рисует карту к месту, которого не существует. Полный речевой портрет и 120 боевыех/бытовых барков.",
        tags: ["#персонажи", "#библия_героя", "#барки", "#мрачное_фэнтези"],
        excerpt: `
          <div class="script-slug">ПСИХОЛОГИЧЕСКИЙ ЯКОРЬ И ГОЛОС</div>
          <p><strong>Ложь персонажа:</strong> «Если привязаться к месту — его обязательно сожгут. Движение — единственная броня.»</p>
